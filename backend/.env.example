GNANI_API_KEY=
GNANI_MODEL=prisma-v3.0
# Prisma v3 auto detects English and nine Indian languages. Set GNANI_LANGUAGE_CODE to pin a locale.
GNANI_STREAM_MODEL=prisma-v3.0
GNANI_LANGUAGE_CODE=indic-auto
# Comma-separated HTTPS origins for a deployed frontend. Local development ports are allowed when the relay host is loopback.
VOICE_ALLOWED_ORIGINS=
# Set for a credential-free voice pipeline demo:
GNANI_MOCK_TRANSCRIPT=
# OpenAI diagram planner. Keep the API key on the backend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Required in production; generate with: openssl rand -hex 32
AUTH_SECRET_KEY=
# PostgreSQL for persistent deployed accounts and projects. Leave empty to use SQLite locally.
DATABASE_URL=
# Direct Neon connection for schema initialization; application requests use DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Local SQLite path when DATABASE_URL is empty.
BOLCANVAS_DB_PATH=
# Optional AgentRouter planner when OpenAI is not configured.
AGENTROUTER_API_KEY=
AGENTROUTER_MODEL=deepseek-v4-flash
# Optional generic OpenAI-compatible planner if AgentRouter is not configured.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
